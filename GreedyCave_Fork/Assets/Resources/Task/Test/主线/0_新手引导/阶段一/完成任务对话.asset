  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48e7f2c47d8987440b8627fd5e613c82, type: 3}
  m_Name: "\u5B8C\u6210\u4EFB\u52A1\u5BF9\u8BDD"
  m_EditorClassIdentifier: 
  speakInfos:
  - speakName: "\u5411\u5BFC"
    content: "\u6B22\u8FCE\u6765\u5230\u8D2A\u5A6A\u6D1E\u7A9F\u590D\u523B\uFF0C\u6211\u662F\u4F60\u7684\u5411\u5BFC\uFF0C\u5C06\u966A\u4F60\u5EA6\u8FC7\u4E00\u4E2A\u77ED\u6682\u7684\u65C5\u7A0B."
  - speakName: "\u5411\u5BFC"
    content: "\u7B80\u5355\u4ECB\u7ECD\u4E00\u4E0B\u6E38\u620F\u7684\u57FA\u672C\u73A9\u6CD5\uFF1A\u548C\u539F\u4F5C\u5DEE\u4E0D\u591A\uFF08\u5927\u6982\uFF09"
  - speakName: "\u5411\u5BFC"
    content: "\u9700\u8981\u6CE8\u610F\u7684\u5730\u65B9\uFF1A\u79BB\u5F00\u6D1E\u7A9F\u6709\u4E09\u79CD\u65B9\u5F0F\n1.\u56DE\u57CE\u5377\u8F74:\u53EA\u80FD\u5E26\u8D70\u8EAB\u4E0A\u5DF2\u7ECF\u88C5\u5907\u7684\u7D2B\u8272\u54C1\u8D28\u4EE5\u4E0A\u7684\u88C5\u5907\u548C\u9B54\u6CD5\u7403(\u50A8\u7269\u5BB9\u5668)\u53CA\u5176\u5185\u5BB9\u7269\u3002(\u5305\u62EC\u8EAB\u4E0A\u643A\u5E26\u7684\u91D1\u5E01\u548C\u672C\u6B21\u6D1E\u7A9F\u5185\u83B7\u5F97\u7684\u7ECF\u9A8C)\n2.\u9B54\u6CD5\u9635(\u6BCF\u6B21\u5237\u65B0\u5730\u56FE\u968F\u673A\u51FA\u73B0\uFF0C\u6BCF\u5341\u5C42\u91CC\uFF0C\u5C42\u6570\u8D8A\u9AD8\uFF0C\u51FA\u73B0\u6982\u7387\u8D8A\u9AD8\uFF0C\u6CA1\u6709\u4FDD\u5E95):\u53EF\u4EE5\u5E26\u8D70\u5168\u8EAB\u4E0A\u4E0B\u7D2B\u8272\u54C1\u8D28\u4EE5\u4E0A\u7684\u7269\u54C1(\u5305\u62EC\u8EAB\u4E0A\u643A\u5E26\u7684\u91D1\u5E01\u548C\u672C\u6B21\u6D1E\u7A9F\u5185\u83B7\u5F97\u7684\u7ECF\u9A8C)\n3.\u5BC4\u5728\u6D1E\u7A9F\u91CC\uFF0C\u4EAB\u53D7\u5168\u81EA\u52A8\u80CC\u5305\u6E05\u7A7A\u670D\u52A1\uFF08\u53EA\u7559\u4E0B\u9B54\u6CD5\u7403\u672C\u8EAB\u548C\u672C\u6B21\u6D1E\u7A9F\u5185\u83B7\u5F97\u7684\u7ECF\u9A8C\uFF09"
  - speakName: Player
    content: "\u4F60\u5728\u5F00\u73A9\u7B11\u5417\uFF1F"
  - speakName: "\u5411\u5BFC"
    content: "\u597D\u7684\uFF0C\u4ECB\u7ECD\u5230\u6B64\u4E3A\u6B62\uFF0C\u4F60\u53EF\u4EE5\u5F00\u59CB\u6E38\u620F\u4E86"
  choices:
  - isInitial: 1
    isSpread: 1
    allControlsHeight: 0
    serializedPropertyHeightInfos:
    - serializedPropertyName: choiceName
      y: 0
    - serializedPropertyName: choiceType
      y: 0
